# Prisma supports the native connection string format for PostgreSQL.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://fwcms:fwcms_dev_password@localhost:5432/fwcms?schema=public"

# Auth.js (NextAuth) — generate a real value for every environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-generated-secret"
